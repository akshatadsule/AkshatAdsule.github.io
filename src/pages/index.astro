---
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import { PERSON_JSON_LD } from "../data/seo";
import Base from "../layouts/Base.astro";
---

<Base>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(PERSON_JSON_LD)}
	/>
	<div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0 lg:flex lg:justify-between lg:gap-4 font-spaceGrotesk">
		<Header />
		<Main />
	</div>
</Base>
