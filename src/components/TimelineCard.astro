---
import Arrow from "./icons/Arrow.astro";
import Link from "./Link.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
	title: string;
	subtitle?: string;
	link: string;
	linkLabel: string;
	startDate: string;
	endDate: string;
	description: string[];
	techStack: string[];
}

const item = Astro.props;
---

<li class="mb-12">
	<div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 w-full md:w-auto text-center md:text-left lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
		{/* shadow */}
		<div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"></div>
		{/* Time */}
		<header class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400 sm:col-span-2">
			{item.startDate} - {item.endDate}
		</header>
		{/* desc */}
		<div class="z-10 sm:col-span-6">
			<h3>
				{
					item.subtitle ? (
						<>
							<span class="text-sm font-semibold text-slate-200">{item.title}</span>
							<span class="block text-lg font-semibold text-slate-100">
								<Link href={item.link} label={item.linkLabel}>{item.subtitle}<Arrow /></Link>
							</span>
						</>
					) : (
						<span class="block text-lg font-semibold text-slate-100">
							<Link href={item.link} label={item.linkLabel}>{item.title}<Arrow /></Link>
						</span>
					)
				}
			</h3>

			<ul class="mt-2 list-disc space-y-1 pl-4 text-left text-sm leading-normal">
				{item.description.map((description) => <li>{description}</li>)}
			</ul>

			{/* Tech used */}
			<ul class="mt-2 flex flex-wrap">
				{item.techStack.map((tech) => <TechBadge>{tech}</TechBadge>)}
			</ul>
		</div>
	</div>
</li>
