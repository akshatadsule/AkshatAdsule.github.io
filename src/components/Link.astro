---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a
	class="font-medium text-slate-200 hover:text-teal-300 focus-visible:text-teal-300"
	href={href}
	target="_blank"
	rel="noreferrer noopener"
	aria-label={`${label} (opens in a new tab)`}><slot /></a>
